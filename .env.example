# Copia este archivo como .env.local (desarrollo) o .env (servidor) y ajusta los valores.

# --- Primera cuenta -------------------------------------------------------
# Con estos datos se crea la cuenta de administrador la PRIMERA vez que
# alguien entra al panel. En cuanto existe una cuenta, estas variables dejan
# de tener efecto: las altas, bajas y contrasenas se manejan en /admin/usuarios.
ADMIN_USER=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=cambia-esta-contrasena

# --- Sesion ---------------------------------------------------------------
# Firma la cookie del panel. Genera una larga y aleatoria, distinta por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esta-clave-larga-y-aleatoria

# --- Direccion publica ----------------------------------------------------
# Con esta direccion se arman el mapa del sitio, el robots.txt y las imagenes
# de vista previa al compartir en WhatsApp y Facebook. Sin barra al final.
SITE_URL=https://notyanl.com

# --- Base de datos (MySQL) ------------------------------------------------
# Los datos viven fuera de la aplicacion para que NO se borren en cada
# despliegue. Con una sola URL:
# DATABASE_URL=mysql://usuario:contrasena@host:3306/basededatos
#
# O por partes:
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Datos ----------------------------------------------------------------
# Carpeta de las imagenes subidas. Por omision public/assets/uploads, que es
# lo que el hosting conserva entre despliegues. Normalmente no se toca.
# UPLOADS_DIR=
